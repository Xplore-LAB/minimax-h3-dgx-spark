# 由 make init 自动改写。必须是已经挂载且可写的 4 TB NVMe 路径。
H3_DATA_ROOT=/mnt/CHANGE_ME/minimax-h3

HOST_UID=1000
HOST_GID=1000

# 默认仅本机监听，通过 SSH 隧道访问。
COMFYUI_BIND=127.0.0.1
COMFYUI_PORT=8188

BASE_IMAGE=nvcr.io/nvidia/pytorch:25.11-py3
COMFYUI_REF=v0.30.0

# GB10 稳定优先配置
RESERVE_VRAM_GB=12
VRAM_HEADROOM_GB=3
ASYNC_OFFLOAD_STREAMS=2
CACHE_MODE=none
CACHE_LRU=1
OMP_NUM_THREADS=12

# 如 Hugging Face 需要认证，填写 token；不要提交到 Git。
HF_TOKEN=

# 可选：附加官方 ComfyUI 参数。基线阶段保持为空。
COMFYUI_EXTRA_ARGS=
